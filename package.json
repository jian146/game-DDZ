{
  "name": "ddz-game",
  "private": true,
  "version": "1.0.0",
  "description": "斗地主 Web 游戏 - 单服务部署包",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter game-ddz-web build && pnpm --filter game-ddz-server build",
    "build:web": "pnpm --filter game-ddz-web build",
    "build:server": "pnpm --filter game-ddz-server build",
    "start": "node game-ddz-server/dist/app.js",
    "serve": "pnpm build && node game-ddz-server/dist/app.js",
    "tunnel": "pnpm build && node scripts/tunnel.js",
    "tunnel:ngrok": "pnpm build && node scripts/tunnel.js --provider ngrok",
    "tunnel:lt": "pnpm build && node scripts/tunnel.js --provider lt",
    "tunnel:cpolar": "pnpm build && node scripts/tunnel.js --provider cpolar",
    "dev:web": "pnpm --filter game-ddz-web dev",
    "dev:server": "pnpm --filter game-ddz-server dev",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\"",
    "typecheck": "pnpm --filter game-ddz-server typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
