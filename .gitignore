# ============================================================
# 斗地主 Web 游戏 — 根级 .gitignore（monorepo）
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
/build/
**/dist/
**/dist-ssr/
**/.next/
**/.nuxt/
**/.turbo/
**/.cache/
**/storybook-static/
**/.tanstack/

# game-ddz-server/public 是 build 脚本复制前端 dist 过去的产物
# 原始静态文件在 game-ddz-web/public/（那个要提交）
game-ddz-server/public/

# TypeScript 增量构建信息
*.tsbuildinfo
tsconfig.tsbuildinfo

# Vite / Rollup 等临时产物
*.local

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- IDE / 编辑器 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- AI / 工具本地配置 ----------
.marscode/
.cursor/
.trae/
.worktrees/

# ---------- 测试 / 覆盖率 ----------
coverage/
*.lcov
.nyc_output/

# ---------- 临时文件 ----------
tmp/
temp/
*.tmp
*.bak
*.orig
